DATABASE_URL=sqlite:///./smarttourist.db
# Generate a strong secret, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Set to true when the backend is served behind HTTPS
COOKIE_SECURE=false
# Comma-separated Overpass (OpenStreetMap) mirrors used by nearby services
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.private.coffee/api/interpreter
